FROM --platform=linux/amd64 python:3.11-slim

# System deps for OpenCV, MediaPipe, WebRTC audio/video codecs
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libopus0 \
    libvpx-dev \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python deps (heavy layer — cached unless requirements change)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy server code, prompts, tasks, and model files
COPY server/ ./server/

# The agent runs from the server directory so relative imports work
WORKDIR /app/server

ENV PORT=8080

CMD ["python", "agent_server.py"]

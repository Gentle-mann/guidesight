# Build stage
FROM --platform=linux/amd64 node:20-slim AS build

WORKDIR /app
COPY client/package.json client/package-lock.json ./
RUN npm ci

COPY client/ .

# Token server URL must be set at build time
ARG VITE_TOKEN_SERVER=http://localhost:8080
ENV VITE_TOKEN_SERVER=$VITE_TOKEN_SERVER

RUN npm run build

# Serve stage
FROM --platform=linux/amd64 nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html

# SPA routing — serve index.html for all routes
RUN echo 'server { listen 80; root /usr/share/nginx/html; location / { try_files $uri $uri/ /index.html; } }' > /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
